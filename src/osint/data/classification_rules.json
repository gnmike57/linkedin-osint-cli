  "hierarchy_patterns": [
    {
      "level": "VP",
      "patterns": [
        "\\b(evp|executive vice president)\\b",
        "\\b(svp|senior vice president)\\b",
        "\\b(vp|vice president)\\b",
        "\\b(avp|assistant vice president)\\b"
      ]
    },
    {
      "level": "Executive",
      "patterns": [
        "\\b(ceo|cto|cfo|coo|ciso|cio|cmo|cso|cpo)\\b",
        "\\bchief\\s+(executive|technology|financial|operating|information|marketing|security|product|data|digital|risk|revenue|people|human|commercial|legal|strategy)\\s+officer\\b",
        "\\b(chairman|chairperson|chairwoman)\\b",
        "\\bdeputy\\s+(ceo|coo|chief)\\b",
        "\\bchief of staff\\b",
        "\\b(co-?founder|founder)\\b",
        "\\b(entrepreneur)\\b"
      ]
    },
    {
      "level": "Executive",
      "pattern": "\\bchief\\s+\\w+\\b",
      "exclude": "\\b(evp|svp|avp|executive vice|senior vice|assistant vice)\\b"
    },
    {
      "level": "Executive",
      "pattern": "\\bpresident\\b",
      "exclude": "\\bvice\\s*president\\b"
    },
    {
      "level": "Executive",
      "pattern": "\\b(general manager|gm)\\b",
      "exclude": "\\bdeputy\\b"
    },
    {
      "level": "Executive",
      "pattern": "\\bexecutive\\b",
      "exclude": "\\bexecutive\\s+(director|assistant|secretary|coach|vice)\\b"
    },
    {
      "level": "Executive",
      "pattern": "\\bowner\\b",
      "exclude": "\\b(product|platform|domain|capability)\\s+owner\\b"
    },
    {
      "level": "Director",
      "patterns": [
        "\\bexecutive director\\b",
        "\\bmanaging director\\b",
        "\\bsenior director\\b",
        "\\bdeputy director\\b"
      ]
    },
    {
      "level": "Director",
      "pattern": "\\bdirector\\b",
      "note": "Generic director - engine handles directorate disambiguation"
    },
    {
      "level": "Head",
      "patterns": [
        "\\bhead of\\b",
        "\\b(division|department|unit|branch|section|group|team)\\s+head\\b",
        "\\bdeputy head\\b",
        "\\bhead\\s+\\w+\\s+(department|division|unit|team|group)\\b",
        "\\b(chapter|tribe|guild)\\s+lead(er)?\\b",
        "\\b(capability|domain)\\s+lead(er)?\\b"
      ]
    },
    {
      "level": "Head",
      "pattern": "\\bhead\\b",
      "require": "\\b(at|@|—|–)\\b"
    },
    {
      "level": "Manager",
      "patterns": [
        "\\bsenior manager\\b",
        "\\bgroup manager\\b",
        "\\bdepartment manager\\b",
        "\\bdivision manager\\b",
        "\\bteam manager\\b",
        "\\b(project|product|program|engineering|development|operations|marketing|sales|hr|finance|it|technical|security|cyber|data|cloud|infrastructure)\\s+manager\\b",
        "\\bpmo\\b",
        "\\bsupervisor\\b"
      ]
    },
    {
      "level": "Manager",
      "pattern": "\\b(manager|manger)\\b",
      "reclassify_to_specialist": "\\b(account|relationship|customer|client)\\s+(manager|manger)\\b"
    },
    {
      "level": "Lead",
      "patterns": [
        "\\bteam lead(er)?\\b",
        "\\b(tech|technical) lead(er)?\\b",
        "\\bgroup lead(er)?\\b",
        "\\b(engineering|development|product|project|qa|security|devops|infrastructure|data)\\s+lead(er)?\\b"
      ]
    },
    {
      "level": "Lead",
      "pattern": "\\blead\\b",
      "require": "\\b(engineer|developer|architect|analyst)\\b"
    },
    {
      "level": "Lead",
      "pattern": "\\blead\\s*$",
      "exclude": "\\b(mislead|plead)\\b"
    },
    {
      "level": "Lead",
      "pattern": "\\w+\\s+lead\\b(?!\\s*(engineer|developer|er\\b))",
      "exclude": "\\b(mislead|plead)\\b"
    },
    {
      "level": "Lead",
      "pattern": "\\b\\w+\\s+leader\\b"
    },
    {
      "level": "Lead",
      "patterns": [
        "\\b(agile|scrum|technical|executive)\\s+coach\\b"
      ]
    },
    {
      "level": "Senior",
      "patterns": [
        "\\bprincipal\\b",
        "\\bstaff (engineer|developer|architect)\\b",
        "\\bsenior\\b"
      ]
    },
    {
      "level": "Specialist",
      "patterns": [
        "\\barchitect\\b",
        "\\bexpert\\b",
        "\\bspecialist\\b",
        "\\bconsultant\\b",
        "\\b(data scientist|scientist)\\b",
        "\\bproduct owner\\b",
        "\\bscrum master\\b",
        "\\b(designer|ux|ui)\\b",
        "\\bactuary\\b",
        "\\bunderwriter\\b",
        "\\b(attorney|lawyer)\\b",
        "\\bstrategist\\b",
        "\\b(advisor|adviser)\\b",
        "\\brecruiter\\b",
        "\\b(legal counsel|counsel)\\b",
        "\\beconomist\\b",
        "\\bhrbp\\b",
        "\\bcompany secretary\\b",
        "\\b(threat hunter|hunter)\\b",
        "\\bcti\\b",
        "\\b(cyber|threat)\\s+intelligence\\b",
        "\\b(platform|domain|capability)\\s+owner\\b",
        "\\b(blue|red|purple)\\s+team(er)?\\b",
        "\\bsecurity\\s+(champion|advocate)\\b",
        "\\bcreator\\b",
        "\\b(incident response|incident responder)\\b",
        "\\b(cyber|security)\\s+awareness\\b",
        "\\b(strategic|corporate|crisis)\\s+communication(s)?\\b",
        "\\bauthor\\b",
        "\\bprofessional\\b",
        "\\badvocate\\b",
        "\\bcpa\\b",
        "\\bdiplomat\\b",
        "\\bprosecutor\\b",
        "\\bpharmacist\\b",
        "\\bphysicist\\b",
        "\\blecturer\\b",
        "\\bprofessor\\b",
        "\\bpsychologist\\b",
        "\\btherapist\\b",
        "\\bnurse\\b"
      ]
    },
    {
      "level": "Entry",
      "patterns": [
        "\\bintern(ship)?\\b",
        "\\bstudent\\b",
        "\\btrainee\\b",
        "\\bcadet\\b"
      ]
    },
    {
      "level": "Entry",
      "pattern": "\\bgraduate\\b",
      "exclude": "\\bpost[- ]?graduate\\b"
    },
    {
      "level": "Junior",
      "patterns": [
        "\\b(junior|jr\\.?)\\b"
      ]
    },
    {
      "level": "Junior",
      "pattern": "\\bassociate\\b",
      "exclude": "associate (director|vp|vice president)"
    },
    {
      "level": "Junior",
      "pattern": "\\bassistant\\b",
      "exclude": "assistant (vp|vice president|director|manager)"
    },
    {
      "level": "Mid-Level",
      "patterns": [
        "\\bengineer\\b",
        "\\b(developer|dev)\\b",
        "\\banalyst\\b",
        "\\bcoordinator\\b",
        "\\bofficer\\b",
        "\\b(administrator|admin)\\b",
        "\\b(researcher|resercher)\\b",
        "\\btechnician\\b",
        "\\brepresentative\\b",
        "\\bbanker\\b",
        "\\bauditor\\b",
        "\\bcontroller\\b",
        "\\bplanner\\b",
        "\\b(instructor|trainer)\\b",
        "\\bclerk\\b",
        "\\bpilot\\b",
        "\\b(editor|writer)\\b",
        "\\baccountant\\b",
        "\\b(purchaser|buyer)\\b",
        "\\bintegrator\\b",
        "\\boperator\\b",
        "\\binspector\\b",
        "\\btester\\b",
        "\\bprogrammer\\b",
        "\\bteacher\\b",
        "\\beducator\\b",
        "\\bsocial worker\\b",
        "\\bsecretary\\b",
        "\\bsoldier\\b",
        "\\bflight attendant\\b",
        "\\bcaptain\\b",
        "\\bdoctor\\b",
        "\\b(salesperson|sales rep)\\b"
      ],
      "skip_if_junior": true
    },
    {
      "level": "Mid-Level",
      "pattern": "\\bmanagement\\b",
      "exclude": "\\bmanager\\b"
    }
  ],
